# Copy to .env (never commit .env).
# Any LiteLLM model id. Use a cheap, fast model for eval runs.
#   Anthropic API:  anthropic/<model-id>
#   AWS Bedrock:    bedrock/<bedrock-model-id>   (uses your AWS credentials / AWS_REGION_NAME)
MIGRATE_AGENT_MODEL=

ANTHROPIC_API_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION_NAME=ap-southeast-1

# Optional: embedding retrieval (off by default; BM25 needs no API key).
# Only used with `scripts/eval_retrieval.py --embeddings`. Any LiteLLM embedding model id.
# MIGRATE_AGENT_EMBED_MODEL=
