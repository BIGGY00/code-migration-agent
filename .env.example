# Copy to .env (never commit .env).
# Any LiteLLM model id. Default: Claude Haiku 5.5 via the Claude API ($0.10 / $0.50 per 1M tokens).
#   Claude API:   anthropic/<model-id>          (requires ANTHROPIC_API_KEY)
#   AWS Bedrock:  bedrock/<bedrock-model-id>    (uses AWS credentials / AWS_REGION_NAME)
#   Others:       any LiteLLM id, e.g. gemini/<model-id> with GEMINI_API_KEY
MIGRATE_AGENT_MODEL=anthropic/claude-haiku-5-5

# Paste your key after the = (starts with sk-ant-). Create it at platform.claude.com -> API Keys.
ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION_NAME=ap-southeast-1

# Optional: embedding retrieval (off by default; BM25 needs no API key).
# Only used with `scripts/eval_retrieval.py --embeddings`. Any LiteLLM embedding model id.
# MIGRATE_AGENT_EMBED_MODEL=
